{
  "name": "@goobits/docs-engine-cli",
  "version": "2.0.1",
  "description": "CLI tools for docs-engine - link checking, validation, versioning, and maintenance",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts"
    },
    "./library": "./src/library.ts"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "docs-engine": "./dist/index.js",
      "create-docs-engine": "./dist/create.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./library": {
        "types": "./dist/library.d.ts",
        "import": "./dist/library.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && node scripts/verifyBuild.mjs",
    "dev": "tsup --watch",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^15.0.0",
    "glob": "^13.0.6",
    "ora": "^9.4.1",
    "p-limit": "^7.3.1",
    "prompts": "^2.4.2",
    "remark-gfm": "^4.0.1",
    "remark-mdx": "^3.1.1",
    "remark-parse": "^11.0.0",
    "typescript": "^6.0.3",
    "ts-morph": "^28.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@goobits/docs-engine": "workspace:*",
    "@types/node": "^26.1.1",
    "@types/prompts": "^2.4.9",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@goobits/docs-engine": "workspace:^"
  },
  "keywords": [
    "documentation",
    "link-checker",
    "versioning",
    "markdown",
    "cli",
    "validation"
  ],
  "license": "FSL-1.1-ALv2",
  "author": "GooBits"
}
