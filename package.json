{
  "name": "@goobits/docs-engine",
  "version": "2.0.3",
  "description": "Battery-included documentation system for SvelteKit with markdown rendering, screenshots, and search",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "source": "./src/lib/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server/index.d.ts",
      "source": "./src/lib/server/index.ts",
      "import": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    },
    "./server/screenshot-service": {
      "types": "./dist/server/screenshot-service.d.ts",
      "source": "./src/lib/server/screenshot-service.ts",
      "import": "./dist/server/screenshot-service.js",
      "default": "./dist/server/screenshot-service.js"
    },
    "./server/markdownRenderer": {
      "types": "./dist/server/markdownRenderer.d.ts",
      "source": "./src/lib/server/markdownRenderer.ts",
      "import": "./dist/server/markdownRenderer.js",
      "default": "./dist/server/markdownRenderer.js"
    },
    "./sveltekit": {
      "types": "./dist/sveltekit/index.d.ts",
      "source": "./src/lib/sveltekit/index.ts",
      "import": "./dist/sveltekit/index.js",
      "default": "./dist/sveltekit/index.js"
    },
    "./plugins": {
      "types": "./dist/plugins/index.d.ts",
      "source": "./src/lib/plugins/index.ts",
      "import": "./dist/plugins/index.js",
      "default": "./dist/plugins/index.js"
    },
    "./reference": {
      "types": "./dist/reference.d.ts",
      "source": "./src/lib/reference.ts",
      "import": "./dist/reference.js",
      "default": "./dist/reference.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "source": "./src/lib/components/index.ts",
      "svelte": "./dist/components/index.js",
      "import": "./dist/components/index.js",
      "default": "./dist/components/index.js"
    },
    "./utils": {
      "types": "./dist/utils/index.d.ts",
      "source": "./src/lib/utils/index.ts",
      "import": "./dist/utils/index.js",
      "default": "./dist/utils/index.js"
    },
    "./utils/openapi-formatter": {
      "types": "./dist/utils/openapi-formatter.d.ts",
      "source": "./src/lib/utils/openapi-formatter.ts",
      "import": "./dist/utils/openapi-formatter.js",
      "default": "./dist/utils/openapi-formatter.js"
    },
    "./navigation-scanner": {
      "types": "./dist/utils/navigation-scanner.d.ts",
      "source": "./src/lib/utils/navigation-scanner.ts",
      "import": "./dist/utils/navigation-scanner.js",
      "default": "./dist/utils/navigation-scanner.js"
    },
    "./config": {
      "types": "./dist/config/index.d.ts",
      "source": "./src/lib/config/index.ts",
      "import": "./dist/config/index.js",
      "default": "./dist/config/index.js"
    },
    "./styles": {
      "source": "./src/lib/styles/index.css",
      "import": "./dist/styles/index.css",
      "default": "./dist/styles/index.css"
    },
    "./styles/*": {
      "source": "./src/lib/styles/*",
      "import": "./dist/styles/*",
      "default": "./dist/styles/*"
    }
  },
  "files": [
    "dist",
    "src/lib"
  ],
  "scripts": {
    "build": "tsup && svelte-package -i src/lib/components -o dist/components -p --tsconfig tsconfig.json && node scripts/finalizePackage.mjs",
    "build:all": "pnpm -r build",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "dev": "tsup --watch",
    "dev:all": "pnpm -r --parallel dev",
    "release": "pnpm -r --filter @goobits/docs-engine build && pnpm -r --filter @goobits/docs-engine-cli build && tsx scripts/bumpIfPublished.ts && npm publish --access public && (cd packages/docs-engine-cli && npm publish --access public)",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check-links": "tsx packages/docs-engine-cli/src/index.ts check-links --base-dir docs --public-dir static",
    "jscpd": "jscpd src",
    "madge": "madge --circular --extensions ts,js src",
    "madge:graph": "madge --image graph.svg --extensions ts,js src",
    "prepublishOnly": "npm run build",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@goobits/logger": "workspace:^",
    "@goobits/sitemap": "workspace:^",
    "dompurify": "^3.4.13",
    "katex": "^0.18.1",
    "lru-cache": "^11.5.2",
    "minisearch": "^7.2.0",
    "p-limit": "^7.3.1",
    "p-retry": "^8.0.0",
    "rehype-katex": "^7.0.1",
    "rehype-stringify": "^10.0.1",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "sharp": "^0.35.3",
    "shiki": "^4.3.1",
    "unist-util-visit": "^5.1.0",
    "@types/mdast": "^4.0.4",
    "@types/unist": "^3.0.3",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@lucide/svelte": "^1.16.0",
    "@sveltejs/kit": "^2.60.1",
    "mermaid": "^11.15.0",
    "svelte": "^5.55.7"
  },
  "peerDependenciesMeta": {
    "mermaid": {
      "optional": true
    }
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-arm64-gnu": "4.62.2",
    "chokidar": "^5.0.0",
    "playwright": "^1.61.1"
  },
  "keywords": [
    "sveltekit",
    "documentation",
    "markdown",
    "mdsvex",
    "docs",
    "screenshots",
    "search"
  ],
  "license": "FSL-1.1-ALv2",
  "author": "GooBits",
  "publishConfig": {
    "access": "public"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.svelte": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@testing-library/svelte": "^5.4.2",
    "@types/node": "^26.1.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "@vitest/ui": "^4.1.10",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-svelte": "^3.22.0",
    "happy-dom": "^20.11.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.12",
    "jsdom": "^29.1.1",
    "lint-staged": "^17.1.0",
    "madge": "^8.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "svelte-eslint-parser": "^1.8.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.12",
    "unified": "^11.0.5",
    "vitest": "^4.1.10"
  }
}
